+"""TRACES Q1 infrastructure (protocol v1.3).
+
+CPU-safe building blocks for single-BOS encoding, residual hybrids, activation
+patching, donor caches, F1/F2/F4, identities 1–9, gates, and workload enumeration.
+
+This package does **not** authorize model inference or scientific outcome collection.
+Synthetic-tensor unit tests exercise logic without loading Gemma weights.
+"""
+
+from __future__ import annotations
+
+__all__ = [
+    "FROZEN_PROTOCOL_VERSION",
+    "FROZEN_SCIENTIFIC_COMMIT",
+]
+
+FROZEN_PROTOCOL_VERSION = "1.3"
+FROZEN_SCIENTIFIC_COMMIT = "b1e8874f45311678e6fa241f504e7e09d4a7808c"
diff --git a/src/traces/q1/adapter_off.py b/src/traces/q1/adapter_off.py
new file mode 100644
index 0000000..bb95802
--- /dev/null
+++ b/src/traces/q1/adapter_off.py
@@ -0,0 +1,64 @@
+"""Adapter-disabled reference helpers (no inference in this module).
+
+Identity 6/7 require comparing adapter-on vs adapter-off activations and
+base-model generation gates. Actual disable/enable must run under authorized
+model execution; these helpers define the API and fail-closed checks.
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Any, Literal
+
+Family = Literal["l19", "l1523"]
+
+
+@dataclass(frozen=True)
+class AdapterOffPlan:
+    family: Family
+    upstream_boundary_layer: int  # exclusive upper bound for equality region
+    asr_threshold: float = 0.01
+    notes: str = ""
+
+
+def adapter_off_plan(family: Family) -> AdapterOffPlan:
+    if family == "l19":
+        return AdapterOffPlan(
+            family=family,
+            upstream_boundary_layer=19,
+            notes="Identity 6: activations/residuals below layer 19 must match",
+        )
+    if family == "l1523":
+        return AdapterOffPlan(
+            family=family,
+            upstream_boundary_layer=15,
+            notes="F7: first adapted layer is 15; equality below 15",
+        )
+    raise ValueError(family)
+
+
+def disable_adapter_layers(model: Any) -> None:
+    """Disable PEFT adapter (fail closed if API missing). Does not run forward."""
+    if hasattr(model, "disable_adapter_layers"):
+        model.disable_adapter_layers()
+        return
+    if hasattr(model, "disable_adapters"):
+        # peft context-manager style may differ; prefer explicit disable
+        cm = model.disable_adapters()
+        if hasattr(cm, "__enter__"):
+            raise RuntimeError(
+                "disable_adapters() returned a context manager; use "
+                "disable_adapter_layers() for durable adapter-off reference passes"
+            )
+        return
+    raise RuntimeError("Model has no disable_adapter_layers/disable_adapters API")
+
+
+def enable_adapter_layers(model: Any) -> None:
+    if hasattr(model, "enable_adapter_layers"):
+        model.enable_adapter_layers()
+        return
+    if hasattr(model, "enable_adapters"):
+        model.enable_adapters()
+        return
+    raise RuntimeError("Model has no enable_adapter_layers/enable_adapters API")
diff --git a/src/traces/q1/bos.py b/src/traces/q1/bos.py
new file mode 100644
index 0000000..195db16
--- /dev/null
+++ b/src/traces/q1/bos.py
@@ -0,0 +1,83 @@
+"""Explicit BOS conventions for Q1 prompt encoding.
+
+Primary scientific convention (owner-approved): tokenize the already-rendered
+chat-template string with ``add_special_tokens=False`` → single leading BOS.
+
+Descriptive exception (F6 / §14): double-BOS via default tokenizer call, used
+only for the exploratory 64-pair forward ranking on 50 development prompts.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Literal, Mapping
+
+import torch
+
+BosConvention = Literal["single", "double"]
+
+PRIMARY_BOS_CONVENTION: BosConvention = "single"
+DESCRIPTIVE_BOS_CONVENTION: BosConvention = "double"
+
+
+def encode_rendered_prompt(
+    tokenizer: Any,
+    rendered_prompt: str,
+    *,
+    bos_convention: BosConvention = PRIMARY_BOS_CONVENTION,
+    return_tensors: str = "pt",
+) -> Mapping[str, torch.Tensor]:
+    """Encode a rendered chat-template string under an explicit BOS convention.
+
+    Parameters
+    ----------
+    bos_convention:
+        ``"single"`` — ``add_special_tokens=False`` (Q1 primary).
+        ``"double"`` — tokenizer default (Stage-1-like double BOS; descriptive only).
+    """
+    if bos_convention == "single":
+        out = tokenizer(
+            rendered_prompt,
+            return_tensors=return_tensors,
+            add_special_tokens=False,
+        )
+    elif bos_convention == "double":
+        # Explicitly omit add_special_tokens so HF default (True) applies.
+        out = tokenizer(rendered_prompt, return_tensors=return_tensors)
+    else:
+        raise ValueError(
+            f"Unknown bos_convention={bos_convention!r}; expected 'single' or 'double'"
+        )
+    return out
+
+
+def assert_leading_bos_count(
+    input_ids: torch.Tensor | list[int],
+    *,
+    bos_id: int = 2,
+    expected: int,
+    context: str = "",
+) -> None:
+    """Fail closed if leading BOS count disagrees with the declared convention."""
+    if torch.is_tensor(input_ids):
+        ids = input_ids.detach().cpu().view(-1).tolist()
+    else:
+        ids = list(input_ids)
+    n = 0
+    for tok in ids:
+        if int(tok) == int(bos_id):
+            n += 1
+        else:
+            break
+    if n != expected:
+        raise RuntimeError(
+            f"Leading BOS count {n} != expected {expected}"
+            + (f" ({context})" if context else "")
+        )
+
+
+def expected_leading_bos(bos_convention: BosConvention) -> int:
+    if bos_convention == "single":
+        return 1
+    if bos_convention == "double":
+        return 2
+    raise ValueError(bos_convention)
diff --git a/src/traces/q1/caches.py b/src/traces/q1/caches.py
new file mode 100644
index 0000000..aacfe2c
--- /dev/null
+++ b/src/traces/q1/caches.py
@@ -0,0 +1,101 @@
+"""Donor activation caches with isolation and provenance.
+
+Caches store intact T/C residuals and o_proj inputs. Mixing single- and
+double-BOS caches is forbidden (F6).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass, field
+from typing import Any, Literal
+
+import torch
+
+from traces.q1.bos import BosConvention
+from traces.q1.tag_position import TagAlignment
+
+TagName = Literal["T", "C"]
+
+
+@dataclass
+class DonorActivationCache:
+    """Per-instruction donor cache for one BOS convention and one model unit."""
+
+    instruction_id: str
+    bos_convention: BosConvention
+    alignment: TagAlignment
+    model_unit: str
+    residuals_by_layer: dict[TagName, dict[int, torch.Tensor]] = field(
+        default_factory=lambda: {"T": {}, "C": {}}
+    )
+    o_proj_input_by_layer: dict[TagName, dict[int, torch.Tensor]] = field(
+        default_factory=lambda: {"T": {}, "C": {}}
+    )
+    logits: dict[TagName, torch.Tensor | None] = field(
+        default_factory=lambda: {"T": None, "C": None}
+    )
+    margins: dict[TagName, float | None] = field(
+        default_factory=lambda: {"T": None, "C": None}
+    )
+    meta: dict[str, Any] = field(default_factory=dict)
+
+    def store_residual(self, tag: TagName, layer: int, tensor: torch.Tensor) -> None:
+        self.residuals_by_layer[tag][int(layer)] = tensor.detach().clone()
+
+    def store_o_proj_input(self, tag: TagName, layer: int, tensor: torch.Tensor) -> None:
+        self.o_proj_input_by_layer[tag][int(layer)] = tensor.detach().clone()
+
+    def get_residual(self, tag: TagName, layer: int) -> torch.Tensor:
+        try:
+            return self.residuals_by_layer[tag][int(layer)]
+        except KeyError as e:
+            raise KeyError(f"Missing residual tag={tag} layer={layer}") from e
+
+    def get_o_proj_input(self, tag: TagName, layer: int) -> torch.Tensor:
+        try:
+            return self.o_proj_input_by_layer[tag][int(layer)]
+        except KeyError as e:
+            raise KeyError(f"Missing o_proj input tag={tag} layer={layer}") from e
+
+    def clear(self) -> None:
+        self.residuals_by_layer = {"T": {}, "C": {}}
+        self.o_proj_input_by_layer = {"T": {}, "C": {}}
+        self.logits = {"T": None, "C": None}
+        self.margins = {"T": None, "C": None}
+
+
+class CacheRegistry:
+    """Isolate caches by (model_unit, bos_convention, instruction_id)."""
+
+    def __init__(self) -> None:
+        self._stores: dict[tuple[str, BosConvention, str], DonorActivationCache] = {}
+
+    def put(self, cache: DonorActivationCache) -> None:
+        key = (cache.model_unit, cache.bos_convention, cache.instruction_id)
+        self._stores[key] = cache
+
+    def get(
+        self,
+        model_unit: str,
+        bos_convention: BosConvention,
+        instruction_id: str,
+    ) -> DonorActivationCache:
+        key = (model_unit, bos_convention, instruction_id)
+        if key not in self._stores:
+            raise KeyError(f"No cache for {key}")
+        return self._stores[key]
+
+    def require_convention(
+        self, cache: DonorActivationCache, bos_convention: BosConvention
+    ) -> None:
+        if cache.bos_convention != bos_convention:
+            raise RuntimeError(
+                f"F6 isolation: refuse to use {cache.bos_convention} cache under "
+                f"{bos_convention} request"
+            )
+
+    def clear(self) -> None:
+        self._stores.clear()
+
+    def __len__(self) -> int:
+        return len(self._stores)
diff --git a/src/traces/q1/conditions.py b/src/traces/q1/conditions.py
new file mode 100644
index 0000000..d378247
--- /dev/null
+++ b/src/traces/q1/conditions.py
@@ -0,0 +1,172 @@
+"""Enumerate Required Recommended-tier intervention conditions (no execution)."""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Iterator, Literal
+
+from traces.q1.patching import CORE_TRIPLE, NOMINATED_PAIR, HeadRef
+
+Direction = Literal["forward", "reverse"]
+N_LAYERS = 26  # Gemma-2-2B layers 0..25
+N_HEADS = 8
+UPSTREAM_LAYERS = tuple(range(0, 19))  # 0..18 → 152 heads
+DOWNSTREAM_LAYERS = tuple(range(19, 26))  # 19..25 → 56 heads
+
+
+@dataclass(frozen=True)
+class Condition:
+    kind: str
+    direction: Direction | None
+    heads: tuple[HeadRef, ...] = ()
+    layer: int | None = None
+    hybrid: str | None = None
+    k: int | None = None
+    bos_convention: str = "single"
+    notes: str = ""
+
+    @property
+    def condition_id(self) -> str:
+        parts = [self.kind]
+        if self.direction:
+            parts.append(self.direction)
+        if self.hybrid:
+            parts.append(self.hybrid)
+        if self.layer is not None:
+            parts.append(f"L{self.layer}")
+        if self.k is not None:
+            parts.append(f"k{self.k}")
+        if self.heads:
+            parts.append("+".join(h.component_id for h in self.heads))
+        if self.bos_convention != "single":
+            parts.append(self.bos_convention)
+        return "|".join(parts)
+
+
+def iter_upstream_heads() -> Iterator[HeadRef]:
+    for layer in UPSTREAM_LAYERS:
+        for h in range(N_HEADS):
+            yield HeadRef(layer, h)
+
+
+def iter_downstream_heads() -> Iterator[HeadRef]:
+    for layer in DOWNSTREAM_LAYERS:
+        for h in range(N_HEADS):
+            yield HeadRef(layer, h)
+
+
+def iter_layer15_16_pairs() -> Iterator[tuple[HeadRef, HeadRef]]:
+    for h15 in range(N_HEADS):
+        for h16 in range(N_HEADS):
+            yield HeadRef(15, h15), HeadRef(16, h16)
+
+
+def enumerate_primary_l19_conditions(
+    *,
+    include_downstream56: bool = True,
+) -> list[Condition]:
+    """Per-prompt condition catalog for primary confirmatory l19 (both dirs)."""
+    out: list[Condition] = []
+    # Boundary hybrids needing forwards: CT, TC (TT/CC free from intact)
+    for name in ("CT", "TC"):
+        out.append(Condition(kind="boundary_hybrid", direction=None, hybrid=name))
+    for direction in ("forward", "reverse"):
+        for head in iter_upstream_heads():
+            out.append(
+                Condition(kind="single_head", direction=direction, heads=(head,))
+            )
+        for h15, h16 in iter_layer15_16_pairs():
+            out.append(
+                Condition(kind="pair", direction=direction, heads=(h15, h16))
+            )
+        out.append(
+            Condition(kind="joint_triple", direction=direction, heads=CORE_TRIPLE)
+        )
+        out.append(
+            Condition(
+                kind="all_upstream",
+                direction=direction,
+                heads=tuple(iter_upstream_heads()),
+            )
+        )
+        for k in range(1, 11):
+            out.append(
+                Condition(
+                    kind="crossfit_topk",
+                    direction=direction,
+                    k=k,
+                    notes="selection fixed from opposite fold; one eval fold per prompt",
+                )
+            )
+        for layer in UPSTREAM_LAYERS:
+            heads = tuple(HeadRef(layer, h) for h in range(N_HEADS))
+            out.append(
+                Condition(
+                    kind="layer_joint_8head",
+                    direction=direction,
+                    layer=layer,
+                    heads=heads,
+                )
+            )
+        if include_downstream56:
+            for head in iter_downstream_heads():
+                out.append(
+                    Condition(
+                        kind="downstream_head_secondary",
+                        direction=direction,
+                        heads=(head,),
+                    )
+                )
+    # Residual sweep CT/TC at layer inputs 1..25
+    for layer in range(1, 26):
+        for name in ("CT", "TC"):
+            out.append(
+                Condition(
+                    kind="residual_sweep_hybrid",
+                    direction=None,
+                    hybrid=name,
+                    layer=layer,
+                )
+            )
+    return out
+
+
+def enumerate_secondary_l1523_conditions() -> list[Condition]:
+    out: list[Condition] = []
+    for name in ("CT", "TC"):
+        out.append(Condition(kind="boundary_hybrid", direction=None, hybrid=name))
+    for direction in ("forward", "reverse"):
+        for h15, h16 in iter_layer15_16_pairs():
+            out.append(Condition(kind="pair", direction=direction, heads=(h15, h16)))
+        for head in NOMINATED_PAIR:
+            out.append(
+                Condition(kind="nominated_single", direction=direction, heads=(head,))
+            )
+    return out
+
+
+def enumerate_double_bos_descriptive_pairs() -> list[Condition]:
+    """Exploratory-only: 64-pair forward under double BOS."""
+    return [
+        Condition(
+            kind="pair",
+            direction="forward",
+            heads=(h15, h16),
+            bos_convention="double",
+            notes="descriptive F6 exception; own double-BOS b_i",
+        )
+        for h15, h16 in iter_layer15_16_pairs()
+    ]
+
+
+def count_primary_tf_per_prompt(include_downstream56: bool = True) -> dict[str, int]:
+    """Match readiness enumerator bookkeeping (intact T/C separate)."""
+    conds = enumerate_primary_l19_conditions(
+        include_downstream56=include_downstream56
+    )
+    return {
+        "patched_or_hybrid_conditions": len(conds),
+        "intact_tf_T_C": 2,
+        "tf_total": len(conds) + 2,
+        "gen_total": 2,
+    }
